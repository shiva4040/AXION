# AXION Environment Configuration Template

# Application Environment
AXION_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=axion_db
POSTGRES_USER=axion_user
POSTGRES_PASSWORD=axion_secure_password_123

# Database URL for async SQLAlchemy
DATABASE_URL=postgresql+asyncpg://axion_user:axion_secure_password_123@localhost:5432/axion_db

# SQLite fallback for offline unit tests (uncomment if testing without Postgres)
# DATABASE_URL=sqlite+aiosqlite:///./axion_test.db

# LLM Provider Configuration
DEFAULT_LLM_PROVIDER=mock # options: mock, openai, gemini, anthropic, vllm
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
VLLM_BASE_URL=http://localhost:8000/v1

# Embedding Configuration
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# Document Storage Path
DOCUMENT_STORAGE_DIR=./storage/documents
